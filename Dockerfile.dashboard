FROM node:22-alpine AS build

WORKDIR /app/services/dashboard/pulsequeue

COPY services/dashboard/pulsequeue/package*.json ./

RUN npm ci

COPY services/dashboard/pulsequeue ./

ARG VITE_API_URL=http://localhost:5000
ARG VITE_SOCKET_URL=http://localhost:5000

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/services/dashboard/pulsequeue/dist /usr/share/nginx/html

EXPOSE 80
